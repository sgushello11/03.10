<Controls:MetroWindow x:Class="ProjectManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Project Manager" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource AccentColorBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Меню -->
        <StackPanel Grid.Column="0" Background="#FF2D2D30">
            <TextBlock Text="PROJECT MANAGER" Foreground="White"
                       FontSize="16" FontWeight="Bold" Margin="15"/>

            <Button Content="Главная" Margin="10,5" Click="Nav_Click" Tag="home"/>
            <Button Content="Проекты" Margin="10,5" Click="Nav_Click" Tag="projects"/>
            <Button Content="Задачи" Margin="10,5" Click="Nav_Click" Tag="tasks"/>
            <Button Content="Статистика" Margin="10,5" Click="Nav_Click" Tag="stats"/>
            <Button Content="Настройки" Margin="10,5" Click="Nav_Click" Tag="settings"/>
        </StackPanel>

        <!-- Содержимое -->
        <Grid Grid.Column="1" Margin="20">
            <!-- Главная -->
            <StackPanel x:Name="PageHome">
                <TextBlock Text="Главная" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <UniformGrid Columns="3">
                    <Controls:Tile Title="ПРОЕКТЫ" Count="12"
                                   Margin="10" Width="180" Height="120"
                                   Background="#FF0078D7"/>
                    <Controls:Tile Title="ЗАДАЧИ" Count="37"
                                   Margin="10" Width="180" Height="120"
                                   Background="#FF107C10"/>
                    <Controls:Tile Title="ВЫПОЛНЕНО" Count="24"
                                   Margin="10" Width="180" Height="120"
                                   Background="#FFCA5010"/>
                </UniformGrid>

                <TextBlock Text="Прогресс проекта" Margin="10,30,0,5"/>
                <ProgressBar Value="60" Margin="10" Width="400"
                             HorizontalAlignment="Left" Height="20"/>
            </StackPanel>

            <!-- Проекты -->
            <StackPanel x:Name="PageProjects" Visibility="Collapsed">
                <TextBlock Text="Проекты" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Добавить" Margin="5" Click="AddProject_Click"
                            Background="#FF0078D7" Foreground="White" BorderThickness="0"/>
                    <Button Content="Изменить" Margin="5" Click="EditProject_Click"
                            Background="#FF0078D7" Foreground="White" BorderThickness="0"/>
                    <Button Content="Удалить" Margin="5" Click="DeleteProject_Click"
                            Background="#FFD13438" Foreground="White" BorderThickness="0"/>
                    <Button Content="Открыть" Margin="5" Click="OpenProject_Click"
                            Background="#FF107C10" Foreground="White" BorderThickness="0"/>
                    <Button Content="Внимание" Margin="5"
                            Background="#FFFFB900" Foreground="Black" BorderThickness="0"/>
                </StackPanel>

                <ListBox x:Name="ProjectsList" Height="300"/>
            </StackPanel>

            <!-- Задачи -->
            <StackPanel x:Name="PageTasks" Visibility="Collapsed">
                <TextBlock Text="Задачи" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" Height="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}"/>
                        <DataGridTextColumn Header="Дедлайн" Binding="{Binding Deadline, StringFormat=dd.MM.yyyy}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Изменить" Margin="5"
                            Background="#FF0078D7" Foreground="White" BorderThickness="0"/>
                    <Button Content="Удалить" Margin="5"
                            Background="#FFD13438" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Статистика -->
            <StackPanel x:Name="PageStats" Visibility="Collapsed">
                <TextBlock Text="Статистика" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Здесь будет статистика" Margin="10"/>
            </StackPanel>

            <!-- Настройки -->
            <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                <TextBlock Text="Настройки" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

                <CheckBox x:Name="ThemeCheck" Content="Тёмная тема"
                          Margin="10" Checked="Theme_Checked" Unchecked="Theme_Unchecked"/>
                <CheckBox Content="Уведомления" Margin="10" IsChecked="True"/>
                <CheckBox Content="Автосохранение" Margin="10" IsChecked="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Controls:MetroWindow>